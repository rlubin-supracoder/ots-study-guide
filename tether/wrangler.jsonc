{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tether",
  "account_id": "930c639ccd874fcb5c1de90de6d61363",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "tether.russelllubinski.us",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNTABILITY",
        "class_name": "Accountability"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Accountability"
      ]
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.sql"
      ],
      "fallthrough": true
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://tether.russelllubinski.us",
    "ACCESS_TEAM_DOMAIN": "russell-lubinski-valor.cloudflareaccess.com",
    "ACCESS_AUD": "33fa08547c8a9c2209634acc28aa04adaf33463deaa873e21a2eb255f99b11e4"
  },
  "observability": {
    "enabled": false
  }
}
